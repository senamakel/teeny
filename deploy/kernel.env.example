# secrets/kernel.env: what bin/kernel tells the core at every boot. Copy this
# file to secrets/kernel.env (gitignored, mode 0600) and fill it in.
#
# Only LADDER_URL reaches the core's environment. The keys are written into the
# core's encrypted store (workspace/storage.db, under secrets/openhuman.key) and
# can be deleted from this file once the kernel has booted with them.

# The model: any OpenAI-compatible endpoint, run as the core's `local-openai`
# runtime, so no TinyHumans account is needed. KERNEL_MODEL is the model id
# every workload uses.
LADDER_URL=http://ladder:6969/v1
LADDER_API_KEY=
KERNEL_MODEL=
# The model's context window in tokens. Leave unset to read it from the
# endpoint's /models listing (the ladder reports it); set it for an endpoint
# that does not.
# KERNEL_CONTEXT_WINDOW=

# Memory: a CortexDB the core's memory engine reads and writes. Leave unset to
# run without memory.
CORTEX_API_URL=
CORTEX_API_KEY=
