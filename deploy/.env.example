# Copy to deploy/.env on the DEPLOY MACHINE (not committed) and fill in.
# deploy.sh ships this file to the box next to the compose file.
#
# The split: this file is the infrastructure around the agent (database,
# memory tier, model endpoint, ports). The repo-root .env is the agent's own
# credentials (X, Exa, Giphy, persona) and is shipped separately.

# --- database --------------------------------------------------------------
# The password has no default on purpose: compose refuses to start without it
# rather than quietly running an open database.
MONGO_ROOT_USERNAME=teeny
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=teeny

# --- loopback ports on the box ---------------------------------------------
# Nothing here takes a public port. Defaults avoid what the other stacks on
# this box already use (3000, 3100, 8080, 27019, 3141).
BOT_PORT=3110
CORTEX_PORT=3142
MONGO_PORT=27020
# The landing page (teeny.enamakel.com), proxied by the host nginx.
WEB_PORT=3120
# Where the page reads the live reflection feed from. Defaults to the bot's
# GET /mind over the compose network; set only to point it somewhere else.
MIND_FEED_URL=

# --- the model endpoint ----------------------------------------------------
# The ladder speaks the OpenAI API on :6969 and is a container this project
# does not own. Two ways to reach it:
#
#   same box   leave LADDER_URL unset. deploy.sh joins the container named
#              LADDER to this project's network so `ladder` resolves as a
#              hostname, which is the only way in: it binds 127.0.0.1, so
#              host.docker.internal cannot reach it from a container.
#   other box  set LADDER_URL to a URL reachable FROM A CONTAINER on this box.
#              deploy.sh proves it answers before releasing.
LADDER_URL=
LADDER=ladder
LADDER_API_KEY=ladder-local-dev-key

# --- memory tier -----------------------------------------------------------
# CortexDB's own API key. The agent sends it as CORTEX_TOKEN in the repo-root
# .env, and deploy.sh refuses to deploy when the two differ.
# Generate with: openssl rand -hex 32
CORTEX_API_KEY=
# Which ladder tier each part of CortexDB calls. The embedding pair is pinned
# on first ingest and irreversible after it: changing either later orphans
# everything already stored.
CORTEX_LLM_MODEL=flash
CORTEX_EMBEDDING_MODEL=vectors
CORTEX_EMBEDDING_DIMS=3072
CORTEX_ENRICHMENT_MODEL=flash
CORTEX_ANSWER_MODEL=reasoning
CORTEX_VERIFIER_MODEL=reasoning

# --- the brain -------------------------------------------------------------
# Teeny's brain is an OpenCompany company whose whole state is the public
# checkout of git@github.com:teenydroid/brain.git (deploy/README.md, "The
# brain"). Nothing under it holds a credential; everything the host needs
# arrives from here.
#
# The host image. Pulled, never built on the box. There is no default because
# as of 2026-09-14 tinyhumansai publishes no OpenCompany image yet; set it to
# whatever they publish (built with at least the `openhuman mcp` features --
# the default build is an echo brain that does no real work).
OPENCOMPANY_IMAGE=
# The live checkout on the box. OUTSIDE the rsynced source tree, because
# deploy.sh syncs with --delete and this directory is live state. deploy.sh
# clones it there on the first deploy and never touches it again.
BRAIN_DIR=/home/droid/brain
BRAIN_REMOTE=git@github.com:teenydroid/brain.git
BRAIN_BRANCH=main
# The uid/gid the two brain containers run as: the checkout's owner, so the
# host's writes are committable. `id -u droid` / `id -g droid` on the box.
BRAIN_UID=1000
BRAIN_GID=1000
# Loopback port for the host + console. ssh -L 3130:127.0.0.1:3130 to reach it.
BRAIN_PORT=3130
# The address allowed to sign in as admin. The manifest names nobody; this is
# the standing grant. First password: deploy/README.md, "The brain".
BRAIN_ADMIN_EMAIL=
# A WRITE deploy key for teenydroid/brain, on the box, readable by BRAIN_UID:
#   ssh-keygen -t ed25519 -N '' -C 'teeny brain-sync' -f ~/.ssh/brain_deploy_key
#   gh repo deploy-key add ~/.ssh/brain_deploy_key.pub -R teenydroid/brain --allow-write -t brain-sync
BRAIN_DEPLOY_KEY=/home/droid/.ssh/brain_deploy_key
# How often brain-sync commits and pushes what changed, in seconds. Every
# run's state lands within one interval; `docker exec teeny-brain-sync-1
# sync-now` does it immediately.
BRAIN_SYNC_INTERVAL=60
