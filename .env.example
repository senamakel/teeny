PORT=3001
LOG_LEVEL=info

# Safe by default: replies are generated and logged, but not posted.
DRY_RUN=true
REPLY_CRON=*/5 * * * *
MAX_REPLIES_PER_RUN=5

X_BOT_USERNAME=stonksrocks
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# In production compose overrides this with the in-network service name.
CORTEX_API_URL=http://127.0.0.1:3141
CORTEX_ACTOR=agent:stonks-rocks-x-bot
CORTEX_SCOPE=agent:stonks-rocks-x-bot
CORTEX_TOKEN=

# Any OpenAI-compatible chat-completions endpoint.
# Any OpenAI-compatible endpoint. In production this is the ladder on the box.
LLM_BASE_URL=http://127.0.0.1:6969/v1
LLM_API_KEY=
LLM_MODEL=

# LangGraph agent. `langgraph` routes cron replies through the agent (memory +
# Exa research + X context); `simple` keeps the single chat-completion path.
AGENT_MODE=langgraph
AGENT_MAX_STEPS=24
# Required to expose POST /agent/run. At least 16 characters; leave unset to
# keep the endpoint disabled.
AGENT_API_TOKEN=

# Optional. Without it the agent runs without web research tools.
EXA_API_KEY=

# Persona. SOUL.md is the account's identity and voice; every SKILL.md under
# SKILLS_DIR is appended to the agent's system prompt. Paths are relative to the
# working directory. Leave either missing to run without it.
SOUL_PATH=SOUL.md
# The facts the account may treat as known.
CONTEXT_PATH=CONTEXT.md
SKILLS_DIR=skills
# Hard cap enforced by the x_post tool, not just asked for in the prompt.
MAX_EMOJI_PER_POST=1

# GIFs. The account posts from its own Giphy channel by default; the agent can
# be told to look beyond it. Without a key the bot posts text only.
GIPHY_API_KEY=
GIPHY_CHANNEL=TinyHumansAI

# Cost dials. X bills per post retrieved, not per request, so the poll asks
# only for what arrived since the previous poll.
# How far back the very first poll of a fresh state reaches.
MENTION_LOOKBACK_MINUTES=15
# Ceiling on posts pulled by any one search, including the agent's own. X's
# floor is 10, so a smaller number still bills for 10.
X_SEARCH_MAX_RESULTS=10

# Ingest and reply are separate roles over one cache, so the reply side can be
# restarted or slowed without pausing the half that has a deadline: X's search
# only reaches back 7 days. `all` runs both in one process.
SERVICE_ROLE=all
INGEST_CRON=*/5 * * * *
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=stonks
MENTIONS_COLLECTION=mentions
