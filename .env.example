PORT=3001
LOG_LEVEL=info

# Safe by default: replies are generated and logged, but not posted.
DRY_RUN=true
REPLY_CRON=*/5 * * * *
MAX_REPLIES_PER_RUN=5

X_BOT_USERNAME=stonksrocks
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# In production compose overrides this with the in-network service name.
CORTEX_API_URL=http://127.0.0.1:3141
CORTEX_ACTOR=agent:stonks-rocks-x-bot
CORTEX_SCOPE=agent:stonks-rocks-x-bot
CORTEX_TOKEN=

# Any OpenAI-compatible chat-completions endpoint.
# Any OpenAI-compatible endpoint. In production this is the ladder on the box.
LLM_BASE_URL=http://127.0.0.1:6969/v1
LLM_API_KEY=
LLM_MODEL=

# LangGraph agent. `langgraph` routes cron replies through the agent (memory +
# Exa research + X context); `simple` keeps the single chat-completion path.
AGENT_MODE=langgraph
AGENT_MAX_STEPS=24
# Required to expose POST /agent/run. At least 16 characters; leave unset to
# keep the endpoint disabled.
AGENT_API_TOKEN=

# Optional. Without it the agent runs without web research tools.
EXA_API_KEY=

# Persona. SOUL.md is the account's identity and voice; every SKILL.md under
# SKILLS_DIR is appended to the agent's system prompt. Paths are relative to the
# working directory. Leave either missing to run without it.
SOUL_PATH=SOUL.md
# The facts the account may treat as known.
CONTEXT_PATH=CONTEXT.md
SKILLS_DIR=skills
# Hard cap enforced by the x_post tool, not just asked for in the prompt.
MAX_EMOJI_PER_POST=1

# GIFs. The account posts from its own Giphy channel by default; the agent can
# be told to look beyond it. Without a key the bot posts text only.
GIPHY_API_KEY=
GIPHY_CHANNEL=TinyHumansAI

# Cost dials. X bills per post retrieved, not per request, so the poll asks
# only for what arrived since the previous poll.
# How far back the very first poll of a fresh state reaches.
MENTION_LOOKBACK_MINUTES=15
# Ceiling on posts pulled by any one search, including the agent's own. X's
# floor is 10, so a smaller number still bills for 10.
X_SEARCH_MAX_RESULTS=10

# Ingest and reply are separate roles over one cache, so the reply side can be
# restarted or slowed without pausing the half that has a deadline: X's search
# only reaches back 7 days. `all` runs both in one process.
SERVICE_ROLE=all
INGEST_CRON=*/5 * * * *
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=stonks
MENTIONS_COLLECTION=mentions

# --- the wallet -------------------------------------------------------------
# An ERC-20 airdrop on Robinhood Chain (an Arbitrum L2, chain id 4663, gas paid
# in ETH). Off unless switched on, and switched on it still needs both a key and
# a token address, so a half-filled file gets no signer rather than a broken one.
#
# Read src/airdrop/policy.ts before changing any limit. The model chooses whether
# to send and how much within the cap; nothing else here is up to it, and nothing
# written in a post can raise a number below.
AIRDROP_ENABLED=false
# Separate from DRY_RUN: publishing replies and spending money are different
# decisions, and this one stays on until the wallet has been watched for a while.
AIRDROP_DRY_RUN=true
# 32 bytes of hex. This is the account's own key and the only secret here that
# is worth real money -- it never belongs in git, a log line, or a reply.
AIRDROP_PRIVATE_KEY=
# The $TINY ERC-20 contract on Robinhood Chain: Tiny Humans AI, 18 decimals.
AIRDROP_TOKEN_ADDRESS=0xb9CE619b168f325b4eb8C2E8E073501838C7A407
AIRDROP_TOKEN_SYMBOL=TINY
# Optional. Defaults to the public endpoint viem ships for the chain.
AIRDROP_RPC_URL=
AIRDROPS_COLLECTION=airdrops

# The ceilings, all enforced in code against the ledger.
# What the campaign publicly promises each person. The model still chooses,
# but it is told the number it has committed to in front of everybody.
AIRDROP_STANDARD_AMOUNT=100
AIRDROP_MAX_PER_AIRDROP=100
AIRDROP_MAX_PER_DAY=1000
AIRDROP_MAX_PER_RECIPIENT=1
# Off, this pays any address anywhere in the turn, including one that arrived in
# a search result or a recalled memory rather than from the person being
# answered. Leave it on unless you know exactly why you are turning it off.
AIRDROP_REQUIRE_ADDRESS_IN_POST=true
# A weak signal on purpose: a follow costs nothing and a farm can buy a thousand
# of them. It filters drive-by begging; the caps are what make a bad day cheap.
# When X cannot be asked, the answer is treated as no rather than as yes.
AIRDROP_REQUIRE_FOLLOW=true
# Who has been paid, and at which wallet. One wallet claiming from many accounts
# is the ordinary shape of airdrop farming and is invisible without this.
RECIPIENTS_COLLECTION=recipients

# The account's own token contracts, comma separated. Matched against every post
# before drafting: a model will not reliably match a 44-character address
# against a long persona file, and the failure mode is calling your own token
# somebody else's shill in public.
OWN_TOKEN_ADDRESSES=2AF7CqwieUjUPALL7icuZtL3X7wENdjUjGBMmfV2pump,0xb9CE619b168f325b4eb8C2E8E073501838C7A407
# How much of the thread to fetch before drafting. Every post retrieved is
# billed by X and the floor on a search is ten. Zero turns it off.
THREAD_CONTEXT_MAX_POSTS=10

# How the reply half drains the queue. `worker` consumes it continuously, which
# is what turns a webhook delivery into a reply in seconds; `cron` keeps the old
# REPLY_CRON timer. The worker asks again immediately whenever it found work and
# waits REPLY_IDLE_MS when it did not, so an empty queue costs one indexed query
# per tick.
REPLY_MODE=worker
REPLY_IDLE_MS=2000
# The least time between two published replies. A giveaway had the account
# answering a hundred people in an hour and X throttled its reach for it;
# a minute apart the same replies read as a conversation. 0 disables it.
REPLY_MIN_INTERVAL_MS=60000
