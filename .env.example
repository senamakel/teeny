PORT=3001
LOG_LEVEL=info

# Safe by default: replies are generated and logged, but not posted.
DRY_RUN=true
REPLY_CRON=*/5 * * * *
MAX_REPLIES_PER_RUN=5

X_BOT_USERNAME=stonksrocks
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# In production compose overrides this with the in-network service name.
CORTEX_API_URL=http://127.0.0.1:3141
CORTEX_ACTOR=agent:stonks-rocks-x-bot
CORTEX_SCOPE=agent:stonks-rocks-x-bot
CORTEX_TOKEN=

# Any OpenAI-compatible chat-completions endpoint.
# Any OpenAI-compatible endpoint. In production this is the ladder on the box.
LLM_BASE_URL=http://127.0.0.1:6969/v1
LLM_API_KEY=
LLM_MODEL=

# LangGraph agent. `langgraph` routes cron replies through the agent (memory +
# Exa research + X context); `simple` keeps the single chat-completion path.
AGENT_MODE=langgraph
AGENT_MAX_STEPS=24
# Required to expose POST /agent/run. At least 16 characters; leave unset to
# keep the endpoint disabled.
AGENT_API_TOKEN=

# Optional. A copy of every X webhook delivery teeny verifies is
# POSTed to this URL, byte for byte with X's `x-twitter-webhooks-signature`
# header still on it, so the receiver can check it against the same
# X_API_SECRET. WEBHOOK_FORWARD_TOKEN (16+ characters) is sent as a bearer
# when set. Fire and forget, after X has been answered: a receiver that is
# slow or down costs nothing here, and a copy that does not arrive is lost.
WEBHOOK_FORWARD_URL=
WEBHOOK_FORWARD_TOKEN=

# Optional. Without it the agent runs without web research tools.
EXA_API_KEY=

# Persona. SOUL.md is the account's identity and voice; every SKILL.md under
# SKILLS_DIR is appended to the agent's system prompt. Paths are relative to the
# working directory. Leave either missing to run without it.
SOUL_PATH=SOUL.md
# The facts the account may treat as known.
CONTEXT_PATH=CONTEXT.md
SKILLS_DIR=skills
# Hard cap enforced by the x_post tool, not just asked for in the prompt.
MAX_EMOJI_PER_POST=1
# Content filter. The lexicon and the link allowlist always run; the model
# judge is the second opinion on anything phrased around the words.
SAFETY_JUDGE=true
SAFETY_JUDGE_MODEL=
# The ranker's reader: a second model call that scores a draft the way X's For
# You ranker would and hands back fixes. x_critique for the agents, a read of
# the morning script and caption, POST /critique for anything else. Advisory,
# and only on the pipelines that generate a post, never on replies.
ALGO_CRITIC=true
ALGO_CRITIC_MODEL=flash
# Extra hosts the account may link to, comma separated: host, host/path, or host/ for the bare host.
LINK_ALLOWLIST=
# Where held messages, drafts and links are kept for review at /safety.
HOLDS_COLLECTION=holds

# GIFs. The account posts from its own Giphy channel by default; the agent can
# be told to look beyond it. Without a key the bot posts text only.
GIPHY_API_KEY=
GIPHY_CHANNEL=TinyHumansAI

# Cost dials. X bills per post retrieved, not per request, so the poll asks
# only for what arrived since the previous poll.
# How far back the very first poll of a fresh state reaches.
MENTION_LOOKBACK_MINUTES=15
# Ceiling on posts pulled by any one search, including the agent's own. X's
# floor is 10, so a smaller number still bills for 10.
X_SEARCH_MAX_RESULTS=10

# Ingest and reply are separate roles over one cache, so the reply side can be
# restarted or slowed without pausing the half that has a deadline: X's search
# only reaches back 7 days. `all` runs both in one process.
SERVICE_ROLE=all   # all | ingest | reply | chart | morning | calendar
INGEST_CRON=*/5 * * * *
MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=stonks
MENTIONS_COLLECTION=mentions

# --- the brain, read-only ----------------------------------------------------
# The brain's checkout (README.md, "The brain"). The bot folds the agents'
# token spend from it into the inference ledger and serves the roster and
# the latest runs at /brain. Locally the submodule; on the box, BRAIN_DIR
# mounted read-only (deploy/compose.prod.yaml). Blank to do neither.
BRAIN_DATA_DIR=brain
BRAIN_COMPANY=teeny
BRAIN_USAGE_CRON=* * * * *

# --- the cadence -------------------------------------------------------------
# The content calendar's one rule: the account's own posts -- morning, chart,
# moon, calendar items, anything the agent is asked to post -- are at least
# this far apart, whichever job writes them. A job whose slot comes sooner
# skips it (the reply lanes are never subject to this). The tolerance covers
# the minutes a job spends drawing and filming after its cron fires, so a
# schedule of exactly eight hours apart still counts. The defaults put the
# morning at 07:00, the chart at 15:00 and the moon at 20:00 UTC.
POST_MIN_GAP_HOURS=8
POST_GAP_TOLERANCE_MINUTES=20
# The heat job reads the last day's own posts' counters on this cron. A post
# gaining at least HOT_IMPRESSIONS_PER_HOUR, and HOT_BASELINE_MULTIPLE times
# what the account's posts usually peak at, is hot: the timeline is held for
# it for one slot, extended while it stays hot, up to HOT_MAX_HOLD_SLOTS from
# when it first ran hot. The held slots' reply allowance goes to its thread.
HEAT_ENABLED=true
HEAT_CRON=*/20 * * * *
HOT_IMPRESSIONS_PER_HOUR=500
HOT_BASELINE_MULTIPLE=3
HOT_MAX_HOLD_SLOTS=2
# The reply budget. `auto` is the account answering under its own post, capped
# per post; `smart` is the reply guy answering mentions and quotes out in the
# world, capped per own post published in the last day (a quiet day still
# gets one post's worth). Three posts a day is sixty replies. The people who
# interact most -- likes, follows, replies, quotes, as the webhook sees them --
# are answered first. Every mention taken is liked, budget or no budget.
REPLY_AUTO_PER_POST=10
REPLY_SMART_PER_POST=10
REPLY_LIKE_MENTIONS=true

# --- the content calendar ---------------------------------------------------
# Scheduled posts from calendar.json: a "gm" every morning, a Friday post, a
# Sunday clip, each with its own cron, channels and media. This, and the
# morning post below, is where the account generates pictures without being
# asked. Off by default because it publishes; single-homed like the chart job
# (SERVICE_ROLE=all or calendar). With MORNING_ENABLED the morning job takes
# the "gm" slot and the calendar item of that name is skipped.
CALENDAR_ENABLED=false
CALENDAR_PATH=calendar.json
# Telegram chats an item posts to when it names none of its own, comma
# separated. A group id is negative, e.g. -1001234567890.
CALENDAR_TELEGRAM_CHAT_IDS=

# --- telegram ---------------------------------------------------------------
# The same account on Telegram: DMs, and groups it is named in or replied to
# in. Set the token from @BotFather and the bot runs; blank, nothing starts.
# It runs inside the ingest process (SERVICE_ROLE=all or ingest), next to the
# webhook. Long polling means exactly one process may hold the token, and
# ingest is already the half that runs in exactly one place.
TELEGRAM_BOT_TOKEN=
# Separate from DRY_RUN, which is about publishing to a public timeline. A DM
# is not a broadcast, so this is off by default; on, drafts are logged not sent.
TELEGRAM_DRY_RUN=false
# A message older than this when first seen is skipped, so a restart does not
# answer an hour of backlog all at once.
TELEGRAM_MAX_MESSAGE_AGE_S=300
TELEGRAM_POLL_TIMEOUT_S=30
# How much of the chat's history the drafter reads before answering, in
# tokens. Every line the bot sees is kept in Mongo (TRANSCRIPT_COLLECTION), so
# this survives restarts. Long-term memory of the person is CortexDB's,
# shared with X. In a group the bot only sees the lines Telegram delivers:
# with privacy mode on that is mentions and replies only, so disable it in
# @BotFather (/setprivacy) and re-add the bot to the group if the whole
# conversation should count.
TELEGRAM_HISTORY_TOKENS=5000
TRANSCRIPT_COLLECTION=telegram_transcript
# Wait this long for the same person to send another message before answering,
# so a thought typed in three pieces gets one reply.
TELEGRAM_DEBOUNCE_MS=2500
# At most one GIF per chat per this many seconds. Reactions are unlimited.
TELEGRAM_GIF_COOLDOWN_S=600

# --- media ------------------------------------------------------------------
# Seeing pictures, drawing them, and filming short clips. All three default to
# the LLM ladder, which serves a `vision` chat ladder, an `image` ladder
# (OpenAI Images shape, square by default) and a `video` ladder (a job that is
# polled). Any part can be pointed elsewhere with its own URL, key and model.
# Everything generated is also written to MEDIA_OUTPUT_DIR.
#
# Vision is on by default: photos sent to the bot on Telegram and pictures on
# X mentions are described before drafting, and look_at_image reads any public
# https image URL. Blank the model to turn it off; the account then says it
# cannot see the picture instead of guessing.
VISION_MODEL=vision
VISION_BASE_URL=
VISION_API_KEY=
# Drawing and filming are opt-in, because each one is a bill.
IMAGE_GEN_ENABLED=false
IMAGE_GEN_MODEL=image
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
# Only sent to gpt-image-* / dall-e-*; the ladder's rungs would 400 on it.
IMAGE_GEN_QUALITY=
VIDEO_GEN_ENABLED=false
# `ladder` is POST /video/generations and a polled media.job; `openai` is
# Sora's POST /videos.
VIDEO_GEN_API=ladder
VIDEO_GEN_MODEL=video
VIDEO_GEN_BASE_URL=
VIDEO_GEN_API_KEY=
VIDEO_GEN_SECONDS=4
VIDEO_GEN_TIMEOUT_S=600
MEDIA_OUTPUT_DIR=data/media
# Daily ceilings, per kind, shared by every drafter in the process. The prompt
# asks for restraint; these are what make "make me a video" from a hundred
# strangers survivable.
MEDIA_IMAGES_PER_DAY=20
MEDIA_VIDEOS_PER_DAY=3
# What Tiny looks like. The vision ladder studies these once, a text step
# distils them into one character sheet, and the sheet goes in front of every
# generation prompt that features Tiny. Paths or URLs, comma separated; blank
# uses the artwork vendored under assets/tiny/; `none` turns the sheet off.
# The sheet is cached at REFERENCE_SHEET_PATH and rebuilt when the list changes.
TINY_REFERENCE_IMAGES=
REFERENCE_SHEET_PATH=data/media/reference-sheet.json

# --- the wallet -------------------------------------------------------------
# An ERC-20 airdrop on Robinhood Chain (an Arbitrum L2, chain id 4663, gas paid
# in ETH). Off unless switched on, and switched on it still needs both a key and
# a token address, so a half-filled file gets no signer rather than a broken one.
#
# Read src/airdrop/policy.ts before changing any limit. The model chooses whether
# to send and how much within the cap; nothing else here is up to it, and nothing
# written in a post can raise a number below.
AIRDROP_ENABLED=false
# Separate from DRY_RUN: publishing replies and spending money are different
# decisions, and this one stays on until the wallet has been watched for a while.
AIRDROP_DRY_RUN=true
# 32 bytes of hex. This is the account's own key and the only secret here that
# is worth real money -- it never belongs in git, a log line, or a reply.
AIRDROP_PRIVATE_KEY=
# The $TINY ERC-20 contract on Robinhood Chain: Tiny Humans AI, 18 decimals.
AIRDROP_TOKEN_ADDRESS=0xb9CE619b168f325b4eb8C2E8E073501838C7A407
AIRDROP_TOKEN_SYMBOL=TINY
# Optional. Defaults to the public endpoint viem ships for the chain.
AIRDROP_RPC_URL=
AIRDROPS_COLLECTION=airdrops

# The ceilings, all enforced in code against the ledger.
# What the campaign publicly promises each person. The model still chooses,
# but it is told the number it has committed to in front of everybody.
AIRDROP_STANDARD_AMOUNT=100
AIRDROP_MAX_PER_AIRDROP=100
AIRDROP_MAX_PER_DAY=1000
AIRDROP_MAX_PER_RECIPIENT=1
# Off, this pays any address anywhere in the turn, including one that arrived in
# a search result or a recalled memory rather than from the person being
# answered. Leave it on unless you know exactly why you are turning it off.
AIRDROP_REQUIRE_ADDRESS_IN_POST=true
# A weak signal on purpose: a follow costs nothing and a farm can buy a thousand
# of them. It filters drive-by begging; the caps are what make a bad day cheap.
# When X cannot be asked, the answer is treated as no rather than as yes.
AIRDROP_REQUIRE_FOLLOW=true
# Who has been paid, and at which wallet. One wallet claiming from many accounts
# is the ordinary shape of airdrop farming and is invisible without this.
RECIPIENTS_COLLECTION=recipients

# The account's own token contracts, comma separated. Matched against every post
# before drafting: a model will not reliably match a 44-character address
# against a long persona file, and the failure mode is calling your own token
# somebody else's shill in public.
OWN_TOKEN_ADDRESSES=2AF7CqwieUjUPALL7icuZtL3X7wENdjUjGBMmfV2pump,0xb9CE619b168f325b4eb8C2E8E073501838C7A407
# Handles whose statements the account takes as fact: the lab and the people
# who run it. Matched against the author and the thread before drafting, and
# the drafter is told whose word it can build on. Facts only; the token,
# wallet and content rules cannot be changed from a post by anyone.
TRUSTED_HANDLES=TinyHumansAISol,senamakel,enamakel,tinyhumansai
# Names the account goes by besides its handle, matched as whole words, so a
# post about "Teeny" is recognised as a post about the account and answered in
# the first person rather than as news about some other agent.
SELF_NAMES=Teeny
# How much of the thread to fetch before drafting. Every post retrieved is
# billed by X and the floor on a search is ten. Zero turns it off.
THREAD_CONTEXT_MAX_POSTS=10

# How the reply half drains the queue. `worker` consumes it continuously, which
# is what turns a webhook delivery into a reply in seconds; `cron` keeps the old
# REPLY_CRON timer. The worker asks again immediately whenever it found work and
# waits REPLY_IDLE_MS when it did not, so an empty queue costs one indexed query
# per tick.
REPLY_MODE=worker
REPLY_IDLE_MS=2000
# The gap between two published replies, picked at random in this range. A
# giveaway had the account answering a hundred people in an hour and X
# throttled its reach for it. A range rather than one number because a reply
# exactly every N seconds is its own signature. Min 0 disables pacing.
REPLY_MIN_INTERVAL_MS=30000
REPLY_MAX_INTERVAL_MS=60000

# --- the chart agent ---------------------------------------------------------
# A second agent on its own timer: reads the token's chart once a day and posts
# it with a rendered image. Off by default, because it publishes.
CHART_ENABLED=false
CHART_CRON=0 15 * * *
# The token it looks at. Bound here rather than chosen per run: this agent reads
# posts, and one that can be told which contract to analyse can be told to
# analyse somebody else's.
CHART_TOKEN_ADDRESS=
CHART_TOKEN_SYMBOL=TINY
CHART_CHAIN=solana
CHART_TIMEFRAME=1h
CHART_BARS=120
# native draws the chart here from candles this service fetched. screenshot
# drives a headless browser at a page that draws one, which needs a browser in
# the image and does not work against DEX Screener's embed -- see
# src/chart/renderer.ts.
CHART_RENDERER=native
CHART_URL_TEMPLATE=
CHART_BROWSER_CHANNEL=
CHART_BROWSER_PATH=
CHART_OUTPUT_DIR=data/charts
# What the community is searched for before the daily post. Blank disables the
# pulse tool, and the agent then writes to holders without having read anything
# they said. One X search per run, floor of ten posts.
CHART_COMMUNITY_QUERY=$TINY -is:retweet
# Defaults to the account's own handle.
CHART_WATERMARK=
# A ranked-trader source for KOL and smart-money labels. gmgn.ai itself is
# behind Cloudflare and will not answer a server; point this at a proxy or
# leave it blank, in which case the agent is told it has no KOL data and the
# prompt forbids claiming any.
GMGN_BASE_URL=
# Public RPCs rate-limit getTokenLargestAccounts. Point this at a private node
# if holder data matters.
SOLANA_RPC_URL=
# Wallets worth naming when they show up in the flow, as address:label pairs.
# The label is for the agent's reasoning; no address ever goes into a post.
KOL_WALLETS=

# --- the morning post --------------------------------------------------------
# A good-morning post every day: the news read, one non-political AI/crypto/tech
# story chosen, Tiny drawn inside it from one of the official pictures, a short
# clip filmed from that, and the lot captioned and posted. Off by default,
# because it publishes and spends an image and a video a day. Needs EXA_API_KEY
# and IMAGE_GEN_ENABLED; with VIDEO_GEN_ENABLED the post carries a clip,
# without it the picture. Rehearse with `npm run morning-dry-run`.
MORNING_ENABLED=false
MORNING_CRON=0 7 * * *
# One Exa news query each, comma separated. Political stories are dropped
# before the model chooses, whatever the query.
MORNING_NEWS_TOPICS=artificial intelligence news,crypto and web3 news,technology trends
MORNING_NEWS_DAYS=2
MORNING_STORIES_PER_TOPIC=8
# The timeline next to the news: X's recent search over a few corners (AI memes
# first and doubled, then AI, then crypto builders) plus the trends list where
# the tier has it, shown to the picker with each post's reply/quote/like counts
# so it chooses the subject people will actually talk back to. X bills every
# post read; 20 a corner is about eighty posts a morning, 0 turns it off.
MORNING_X_POSTS_PER_QUERY=20
MORNING_X_HOURS=24
# Replace the built-in corners: `label=query;label=query`, X search syntax.
MORNING_X_QUERIES=
# Whose trends list, as a WOEID: 23424977 is the United States, 1 the world, 0 none.
MORNING_X_TRENDS_WOEID=23424977
# How long the clip is scripted for. A hint to the generator: Sora rounds it to
# 4, 8 or 12; a ladder rung may render its own length.
MORNING_VIDEO_SECONDS=10

# "$TINY with the market cap of X", once a day. The token's row and the AI meme
# coin leaderboard are read from CoinGecko (no key), one coin above it is picked
# as the yardstick, the implied price is drawn as a picture here (no generation
# spent), and two lines go under it. Off by default, because it publishes.
# Rehearse with `npm run moon-dry-run`; the picture lands in MOON_OUTPUT_DIR.
MOON_ENABLED=false
MOON_CRON=0 20 * * *
# The moon chart and the candlestick chart take turns on a rota counted in
# UTC days from the anchor (slot 0): with three days, day one the moon, day
# two the chart, day three quiet. Each keeps its daily cron and skips the
# days that are not its turn.
POST_ROTA_DAYS=3
POST_ROTA_ANCHOR=2026-09-14
MOON_ROTA_SLOT=0
CHART_ROTA_SLOT=1
# The token by CoinGecko id, and coingecko.com/en/categories/<MOON_CATEGORY>.
MOON_COIN_ID=tiny-humans-ai
MOON_CATEGORY=ai-meme-coins
MOON_BOARD_NAME=AI meme coins
# The whole board is read (paged at 250); TINY has to be on it, and the
# yardsticks are the coins above it there.
MOON_BOARD_SIZE=500
MOON_RUNGS=7
# CoinGecko ids never used as a yardstick: coins the tag is generous about.
MOON_EXCLUDE_IDS=tutorial
# The yardstick is picked between these multiples of the token's own cap.
MOON_MIN_MULTIPLE=2
MOON_MAX_MULTIPLE=2000
MOON_OUTPUT_DIR=data/moon
